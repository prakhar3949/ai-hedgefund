        "85-100": "Modest SBC drag, healthy",
        "70-85": "Material SBC drag — 15-30% of GAAP eaten by dilution",
        "50-70": "Heavy SBC drag",
        "<50": "Severe SBC drag — most of GAAP earnings consumed by dilution",
        "<0": "Owners losing money despite positive GAAP (Tragic Tier)"
      }
    }
